# Stage 1: Build do frontend
FROM node:22-alpine AS build-deps
WORKDIR /app

# Cache dependency install before copying the full frontend source.
COPY frontend/package.json frontend/package-lock.json ./frontend/
WORKDIR /app/frontend
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Stage 2: Final PHP image
FROM php:8.1-apache

RUN docker-php-ext-install mysqli pdo pdo_mysql

RUN a2enmod rewrite

RUN sed -i '/<Directory \/var\/www\/>/,/<\/Directory>/ s/AllowOverride None/AllowOverride All/' /etc/apache2/apache2.conf

ENV APACHE_DOCUMENT_ROOT=/var/www/html/public
RUN sed -ri -e 's!/var/www/html!${APACHE_DOCUMENT_ROOT}!g' /etc/apache2/sites-available/*.conf

COPY . /var/www/html/

# Copy the exported Next.js frontend into the public directory served by Apache.
COPY --from=build-deps /app/frontend/out /var/www/html/public/dist
COPY --from=build-deps /app/frontend/out/_next /var/www/html/public/_next

RUN chown -R www-data:www-data /var/www/html
