{
  "name": "frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 5173 --hostname 0.0.0.0",
    "dev:reset": "powershell -Command \"if (Test-Path .next-dev) { Remove-Item -Recurse -Force .next-dev }; npm run dev\"",
    "build": "next build && node scripts/sync-dist.mjs",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "next": "15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
